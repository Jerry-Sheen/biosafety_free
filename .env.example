# ==============================================================================
# Biosafety Free Pipeline Environment Configuration (.env.example)
# 복사하여 .env 파일로 생성 후 사용하세요. (주의: .env는 절대 git에 커밋 금지)
# ==============================================================================

# [1] 애플리케이션 네트워크 및 전용 포트 설정 (8600번대 충돌 방지)
APP_ENV=development
APP_HOST=0.0.0.0
ADMIN_PORT=8601
USER_PORT=8602
BACKEND_PORT=8600
BACKEND_URL=http://localhost:8600

# [2] 기본 LLM 제공자 설정 (free: 로컬 오픈소스 무료 AI | gemini: Google Gemini | openai: OpenAI)
LLM_PROVIDER=free

# [2-A] 무료 로컬 CPU 오픈소스 LLM 설정 (Intel i7 / 16GB RAM 최적화)
# 모델 예: Qwen/Qwen2.5-1.5B-Instruct (초경량 고속), Qwen/Qwen2.5-3B-Instruct
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LOCAL_LLM_DEVICE=cpu

# [2-B] 필수 고정 임베딩 모델 (admin.py와 user.py/FastAPI 간 100% 동일 모델 유지)
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# [2-C] 유료 고성능 모드 (BYOK: 사용자가 UI에서 직접 입력 가능, 서버 기본값 옵션)
# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=text-embedding-004

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-ada-002

# [3] PDF 분류 및 OCR 임계값 설정
MIN_TEXT_CHARS_PER_PAGE=80
SCANNED_PAGE_RATIO=0.7
OCR_MIN_CONFIDENCE=55.0
OCR_LANGUAGE=kor+eng
OCR_DPI=300
PREFER_RAPIDOCR=true

# Windows Tesseract 실행 파일 수동 경로 (PATH 미등록 시 지정)
TESSERACT_CMD=

# [4] 구조 보존형 청킹 설정
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MIN_CHUNK_SIZE=100

# [5] 벡터 데이터베이스 (ChromaDB) 영구 저장 경로 및 API 구현 방식
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents
ANONYMIZED_TELEMETRY=False

# [6] 업로드 및 처리 디렉토리
UPLOAD_DIRECTORY=data/uploads

# [7] 관리자(Admin) 보안 PIN 번호
ADMIN_ACCESS_PIN=admin1234
